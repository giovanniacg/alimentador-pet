// Copie este arquivo para include/secrets.h e preencha.
// O secrets.h NAO vai para o git (esta no .gitignore).
#pragma once

// --- WiFi ---
#define WIFI_SSID   "nome-da-sua-rede"
#define WIFI_PASS   "senha-da-sua-rede"

// --- Broker MQTT sobre WebSocket seguro (porta 443, atras do Traefik) ---
// MQTT_HOST e so o dominio, sem esquema e sem porta.
// MQTT_PATH e o caminho do WebSocket publicado pelo proxy (o Mosquitto com
// "protocol websockets" normalmente responde em /mqtt).
#define MQTT_HOST   "broker.seu-dominio.com.br"
#define MQTT_PATH   "/mqtt"
#define MQTT_USER   "feeder-sp01"
#define MQTT_PASS   "senha-do-feeder"

// --- Identidade do aparelho ---
// Vira o prefixo de topico: feeder/<FEEDER_ID>/...
#define FEEDER_ID   "sp01"
